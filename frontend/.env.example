# =============================================================================
# Vendora POS Frontend - Environment Variables (Example)
# =============================================================================
# Copy this file to .env.local and fill in the values for your environment.
# NEVER commit the .env.local file to version control.
# =============================================================================

# Backend API base URL — domain only, no path (the /api/v1 prefix is added in code)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Cookie domain for cross-subdomain sharing (e.g., syaad.dev or .syaad.dev)
# Leave blank/empty for local development on localhost
NEXT_PUBLIC_COOKIE_DOMAIN=
