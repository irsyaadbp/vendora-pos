# =============================================================================
# Vendora POS Backend - Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values for your environment.
# NEVER commit the .env file to version control.
# =============================================================================

# Database connection string for Neon PostgreSQL
# Format: postgresql+asyncpg://user:password@host:port/dbname?sslmode=require
DATABASE_URL=

# Secret key used for signing JWT tokens (use a strong random string)
JWT_SECRET=

# JWT access token expiration time in minutes (default: 15)
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15

# JWT refresh token expiration time in days (default: 7)
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Database connection pool size (default: 5)
DB_POOL_SIZE=5

# Stock quantity threshold for low-stock alerts (default: 10)
LOW_STOCK_THRESHOLD=10

# Maximum authentication requests per minute per IP (default: 10)
RATE_LIMIT_AUTH_PER_MINUTE=10

# Maximum consecutive failed login attempts before lockout (default: 5)
MAX_LOGIN_ATTEMPTS=5

# Account lockout duration in minutes after max failed attempts (default: 15)
LOGIN_LOCKOUT_MINUTES=15
